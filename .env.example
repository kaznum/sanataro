# Docker Environment Variables for Sanataro Development

# Database Configuration
# DB_ADAPTER=mysql2          # or postgresql
# DB_HOST=db-mysql           # or db-postgresql
# DB_NAME=sanataro_development
# DB_USERNAME=sanataro
# DB_PASSWORD=sanataro_password

# Rails Configuration
# RAILS_ENV=development
# LOAD_SEEDS=false           # Set to 'true' to load seeds on startup

# Redis Configuration
# REDIS_URL=redis://redis:6379/0

# Admin Configuration (optional)
# ADMIN_USER=admin
# ADMIN_PASSWORD=password
# SECRET_TOKEN=your_secret_token_here